# Copy to .env next to docker-compose.yml and fill in.

# Required: the secret Edge's Traefik adds to every request it forwards here.
# The frontend's nginx refuses any request without it, so LogiSim can't be
# loaded except through the proxy. Must equal LOGISIM_PROXY_SECRET in Edge's
# .env. Generate with: openssl rand -hex 32
PROXY_SECRET=

# Optional: HTTP proxy, used both when building the backend image (pip) and
# at runtime (geocoding with Nominatim, routing with OSRM, gas station
# lookups with Overpass). Leave empty for a direct connection.
# On a network that intercepts outbound TLS (e.g. Zscaler), point these at a
# proxy that reaches the internet directly, e.g.:
#   HTTP_PROXY=http://us08dv2itm94.pmdomhq.protomold.com:8090
#   HTTPS_PROXY=http://us08dv2itm94.pmdomhq.protomold.com:8090
#   NO_PROXY=postgres,localhost,127.0.0.1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Optional: the password that elevates anyone who knows it to the admin role
# (the 🔒 tabs in the tab menu; ERASE SELECTED FILE asks for it too). Admin
# manages what every save file shares: gas stations, vehicle models,
# background jobs, and erasing files. Leave empty to turn admin off.
ADMIN_PASSWORD=
