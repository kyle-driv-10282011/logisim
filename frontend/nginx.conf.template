#
# Rendered by the nginx image at start (envsubst: ${PROXY_SECRET} is filled
# in from the environment) into /etc/nginx/conf.d/default.conf.
#
# Reached only through the Edge reverse proxy (~/Code/Edge), which serves
# https://logisim.kjfries.com and adds X-Edge-Proof: <secret> to every
# request. Anything without the same secret gets a 403, so LogiSim can't be
# loaded any other way - not from the host, not from another container.
#
server {

    listen 80;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    #
    # Every file here is UTF-8. Without this the JS/CSS go out with no
    # charset and the browser falls back to Latin-1, turning e.g. the "·"
    # in the save-file chip into "Â·".
    #
    charset utf-8;
    charset_types text/html text/css application/javascript;

    if ($http_x_edge_proof != "${PROXY_SECRET}") {
        return 403 "LogiSim is only available through its HTTPS address.\n";
    }

    #
    # This app is under active development and rebuilt often - stale cached
    # JS/HTML (browser silently keeping an old app.js against a new
    # index.html, or vice versa) has caused real bugs. Disable caching
    # entirely rather than chase cache-busting for a handful of small files.
    #
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    #
    # The API, on the backend container (no port of its own on the host).
    # Same origin as the page, so no CORS is needed.
    #
    location /api/ {
        proxy_pass http://backend:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Checked above; the backend doesn't need it.
        proxy_set_header X-Edge-Proof "";
        # Gas-price CSV/JSON uploads (POST /api/gas-prices/upload).
        client_max_body_size 25m;
        # Geocoding is rate-limited to 1 request/second, so some calls are slow.
        proxy_read_timeout 300s;
    }
}
